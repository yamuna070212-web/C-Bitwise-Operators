#include <stdio.h>

int main()
{
    int num, n;

    printf("Enter Number: ");
    scanf("%d", &num);

    printf("Enter Bit Position: ");
    scanf("%d", &n);

    num = num & ~(1 << n);

    printf("Result = %d\n", num);

    return 0;
}
Sample Output
Enter Number: 10
Enter Bit Position: 1
Result = 8
