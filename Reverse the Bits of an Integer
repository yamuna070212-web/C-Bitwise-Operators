#include <stdio.h>

int main()
{
    unsigned int num, rev = 0;
    int i;

    printf("Enter Number: ");
    scanf("%u", &num);

    for(i = 0; i < 32; i++)
    {
        rev = (rev << 1) | (num & 1);
        num >>= 1;
    }

    printf("Reversed Bits = %u\n", rev);

    return 0;
}
