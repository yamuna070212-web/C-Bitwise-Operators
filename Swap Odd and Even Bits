#include <stdio.h>

int main()
{
    unsigned int num;

    printf("Enter Number: ");
    scanf("%u", &num);

    unsigned int result = ((num & 0xAAAAAAAA) >> 1) |
                          ((num & 0x55555555) << 1);

    printf("Result = %u\n", result);

    return 0;
}
