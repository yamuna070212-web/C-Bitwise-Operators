#include <stdio.h>

int main()
{
    int a = 10, b = 20;

    printf("Before Swap\n");
    printf("a = %d b = %d\n", a, b);

    a = a ^ b;
    b = a ^ b;
    a = a ^ b;

    printf("After Swap\n");
    printf("a = %d b = %d\n", a, b);

    return 0;
}
Output
Before Swap
a = 10 b = 20

After Swap
a = 20 b = 10
