#include <stdio.h>

int main()
{
    unsigned int num;
    int count = 0;

    printf("Enter Number: ");
    scanf("%u", &num);

    while((num & 1) == 0 && num != 0)
    {
        count++;
        num >>= 1;
    }

    printf("Trailing Zeros = %d\n", count);

    return 0;
}
